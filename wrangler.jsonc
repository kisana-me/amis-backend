{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amis-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amis",
      // 本番の D1 を作ったら `wrangler d1 create amis` の id に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 本体の MariaDB (sessions / accounts / images を読むだけ)。
  // クエリキャッシュは無効にした設定を使う。キャッシュがあるとログアウトがすぐに反映されない
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // `wrangler hyperdrive list` の id に置き換える
      "id": "00000000000000000000000000000000",
      // ローカルの wrangler dev とテストだけで使う接続先 (本体の compose の MariaDB)。デプロイ後は使われない。
      // 環境変数 CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE があればそちらが優先される
      "localConnectionString": "mysql://root:mdbroot@127.0.0.1:3306/amiverse_development"
    }
  ],
  // Amis の画像だけを置くバケット (images/variants/{aid}.webp)。本体のバケットとは分ける。
  // `wrangler r2 bucket create amis-media` で作り、公開のドメインを付けて AMIS_MEDIA_URL にする
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "amis-media" }
  ],
  // アップロードされた画像の切り抜き・縮小・WebP への変換
  "images": { "binding": "IMAGES" },
  // 1 分あたり 10 通まで (本体の RATE_LIMIT_PER_MINUTE)。アカウントごとに数える
  "ratelimits": [
    { "name": "SEND_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    // 本体の S3_PUBLIC_ENDPOINT と同じ値にする (アカウントのアイコンは本体のバケットにある)
    "S3_PUBLIC_ENDPOINT": "",
    // Amis のバケット (amis-media) の公開 URL
    "AMIS_MEDIA_URL": "",
    // 本体の BACK_URL と同じ値にする (代わりの静的な画像を本体から配っている)
    "BACK_URL": "",
    // 本体は TZ=Asia/Tokyo かつ default_timezone :local なので、datetime はタイムゾーンなしの JST で入っている
    "MAIN_DB_TIMEZONE": "+09:00",
    // CORS と CSRF (Origin の確認) で許可するフロントのオリジン。本体の FRONT_URL / DEV_FRONT_URL に当たる。カンマ区切り
    "ALLOWED_ORIGINS": "",
    // 週の原価上限 (マイクロ USD)。全アカウント共通で、0 以下は無制限 (本体の DEFAULT_WEEKLY_COST_LIMIT_MICRO)
    "WEEKLY_COST_LIMIT_MICRO": "5000000"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
